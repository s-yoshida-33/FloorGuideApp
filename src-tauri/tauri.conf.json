{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.tti.gido",
  "productName": "Gido",
  "version": "1.8.13",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gido",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' http://localhost:8090 http://localhost:48080; img-src 'self' asset: https://asset.localhost http://asset.localhost http://localhost:8090 http://localhost:48080 https: http: data: blob:; media-src 'self' asset: https://asset.localhost http://asset.localhost http://localhost:48080 https: http: data: blob:; connect-src 'self' http://localhost:8090 http://localhost:48080 http: https: ws:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' https: data:;",
      "capabilities": [
        "default",
        {
          "identifier": "app-fs-scope",
          "windows": [
            "main"
          ],
          "permissions": [
            {
              "identifier": "fs:scope",
              "allow": [
                "$APPDATA/com.tti.gido/**",
                "$HOME/**"
              ]
            }
          ]
        },
        {
          "identifier": "updater-all",
          "windows": [
            "main"
          ],
          "permissions": [
            "updater:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/capture_and_send.ps1": "capture_and_send.ps1"
    },
    "publisher": "Toei Techno International Inc.",
    "copyright": "© 2026 Toei Techno International Inc.",
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsh",
        "installerIcon": "icons/installer.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://dl.tti.ninja/gido/releases/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QkE1REEyNDM1Nzc1NDgKUldSSWRWZERvbDI2aENEWEF0eVd0NWhubjVsUE1tWGFuMjdiZjlKR3I2ei9VMmIxd3hrWVdLOTkK"
    }
  }
}
